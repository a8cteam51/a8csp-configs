<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<!-- Companion ruleset for tests/. A consumer references this the same way it references
	     phpcs.dist.xml — `<rule ref="vendor/a8csp/configs/php/quality-assurance/phpcs.tests.dist.xml"/>`
	     in its own tests-only ruleset, adding its own text-domain and prefix rules on top. A
	     distinct profile, rather than per-sniff exclude-pattern scoping inside the main ruleset,
	     is what lets test code carry different rule values — not just different rule membership —
	     from production code. -->

	<!-- The rules shared with the production profile, floors included. -->
	<rule ref="./phpcs.base.dist.xml"/>

	<!-- Test-only relaxations: a few sniffs don't apply here — test classes, methods, and
	     properties carry no docblocks, fixtures legitimately override globals, and test
	     helpers need no global prefix. This ruleset only ever scans tests/, so each
	     exclude-pattern below disables the sniff for this entire ruleset. -->
	<rule ref="Squiz.Commenting.ClassComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.VariableComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionCommentThrowTag">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<!-- Test doubles and recorders must match the signature they stand in for. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<!-- Fixture classes co-locate with the test that owns them. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<!-- Test exceptions surface in CLI output, not HTML. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidHookName.UseUnderscores">
		<!-- Tests fire deliberately malformed hook names at validators. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
