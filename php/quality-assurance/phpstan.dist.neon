includes:
    - phpstan.dist.neon.php

parameters:
    level: 8
    inferPrivatePropertyTypeFromConstructor: true
    treatPhpDocTypesAsCertain: false
    typeAliases:
        PluginMetaData: 'array{Name: string, PluginURI: string, Version: string, Description: string, Author: string, AuthorURI: string, TextDomain: string, DomainPath: string, Network: bool, Title: string, AuthorName: string, RequiresPHP: string, RequiresWP: string, UpdateURI: string, RequiresPlugins: string, "WC requires at least"?: string, "WC tested up to"?: string}'
    strictRules:
        disallowedShortTernary: false
